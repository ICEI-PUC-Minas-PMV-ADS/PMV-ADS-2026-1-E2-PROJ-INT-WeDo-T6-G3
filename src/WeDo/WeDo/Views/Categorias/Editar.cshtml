@model WeDo.Models.Categoria
@inject IViewLocalizer Localizer

<div class="container mt-4">
    <h2>@Localizer["Editar Categoria"]</h2>
    <hr />

    <form asp-action="Editar" method="post">
        @* IMPORTANTE: Campo oculto para o ID *@
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label">@Localizer["Nome da Categoria"]</label>
            <input asp-for="Nome" class="form-control" required />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success">@Localizer["Salvar Alterações"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancelar"]</a>
        </div>
    </form>
</div>