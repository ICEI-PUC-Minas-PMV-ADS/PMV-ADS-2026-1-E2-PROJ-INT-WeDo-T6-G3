@model List<WeDo.Models.ViewModels.DashboardViewModel>

@{
    ViewData["Title"] = "Dashboard";
}

<div>
    <form asp-action="Atualizar" asp-controller="Home" method="post">

        @for (int i = 0; i < Model.Count; i++)
        {
            <div class="mb-3 p-3 border rounded">
                <h3>@Model[i].NomeMetaPai</h3>
                <p>@Model[i].DescricaoAtividade</p>
                <p>@Model[i].NomeAtividade</p>

                <input type="hidden" asp-for="@Model[i].AtividadeId" />
                <input type="hidden" asp-for="@Model[i].MetaId" /> <input type="hidden" asp-for="@Model[i].NomeMetaPai" />
                <input type="hidden" asp-for="@Model[i].AtividadeId" />
                <input type="hidden" asp-for="@Model[i].NomeMetaPai" />
                <input type="hidden" asp-for="@Model[i].DescricaoAtividade" />
                <input type="hidden" asp-for="@Model[i].NomeAtividade" />

                <label>Status de Hoje:</label>
                <select asp-for="@Model[i].StatusHoje" class="form-select">
                    <option value="0">Pendente</option>
                    <option value="1">Concluída</option>
                    <option value="2">Cancelada</option>
                </select>
            </div>
        }

        <button type="submit" class="btn btn-success mt-4">Confirmar Tudo</button>

    </form>
</div>