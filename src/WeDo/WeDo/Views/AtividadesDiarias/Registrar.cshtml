@model WeDo.Models.AtividadeDiaria

<div class="container mt-4" style="max-width: 900px;">
    <div class="mb-4">
        <h2 style="font-family: 'Georgia', serif; font-style: italic; color: #222; font-weight: 500;">Registrar nova Atividade</h2>
        <p class="text-muted" style="font-family: 'Georgia', serif; font-style: italic; font-size: 1.05rem;">
            Registre o progresso dos seus objetivos aqui de forma simples.
        </p>
    </div>

    <div class="p-4 p-md-5 bg-light shadow-sm" style="border-radius: 20px; border: 1px solid #e3e3e3;">
        <form asp-action="Registrar">
            
            <div class="mb-4">
                <label class="form-label fw-bold" style="font-family: 'Georgia', serif; font-style: italic; color: #444;">
                    Selecione a Meta Relacionada 🎯
                </label>
                <select asp-for="IdMeta" class="form-select p-3" asp-items="ViewBag.IdMeta" 
                        style="border-radius: 15px; border: 1px solid #ccc; background-color: #e9ecef; font-weight: 500; color: #495057;">
                    <option value="">-- Qual objetivo você avançou? --</option>
                </select>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold" style="font-family: 'Georgia', serif; font-style: italic; color: #444;">
                    O que você fez hoje? (Título) ⚡
                </label>
                <input asp-for="Nome" class="form-control p-3" placeholder="Ex: Treino de pernas concluído" 
                       style="border-radius: 15px; border: 1px solid #ccc; background-color: #fff;" />
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold" style="font-family: 'Georgia', serif; font-style: italic; color: #444;">
                    Relato / Motivação 📝
                </label>
                <textarea asp-for="Descricao" class="form-control p-3" rows="4" 
                          placeholder="Escreva aqui como foi o desempenho ou sua motivação para hoje..."
                          style="border-radius: 15px; border: 1px solid #ccc; background-color: #fff;"></textarea>
            </div>

            <div class="row g-4 mb-5">
                <div class="col-md-6">
                    <label class="form-label fw-bold" style="font-family: 'Georgia', serif; font-style: italic; color: #444;">
                        Data do Registro 📅
                    </label>
                    <input asp-for="Data" type="date" class="form-control p-3" value="@DateTime.Now.ToString("yyyy-MM-dd")" 
                           style="border-radius: 15px; border: 1px solid #ccc; background-color: #e9ecef; color: #495057; font-weight: 500;" />
                </div>
                
                <div class="col-md-6">
                    <label class="form-label fw-bold" style="font-family: 'Georgia', serif; font-style: italic; color: #444;">
                        Link da Foto de Comprovação 🔗
                    </label>
                    <input asp-for="UrlFoto" class="form-control p-3" placeholder="URL da imagem (opcional)" 
                           style="border-radius: 15px; border: 1px solid #ccc; background-color: #fff;" />
                </div>
            </div>

            <div class="d-flex justify-content-end border-top pt-4">
                <button type="submit" class="btn text-white px-5 py-3" 
                        style="background-color: #198754; border-radius: 25px; font-weight: bold; font-size: 1.05rem; transition: all 0.2s ease-in-out; box-shadow: 0 4px 6px rgba(0,0,0,0.08);">
                    Registrar Atividade ✨
                </button>
            </div>
            
        </form>
    </div>
</div>