@model WeDo.Models.Usuario

@{
    ViewData["Title"] = "Configurações de Perfil";
    string iniciais = "?";
    if (!string.IsNullOrWhiteSpace(Model?.Nome))
    {
        var partes = Model.Nome.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length >= 2)
            iniciais = string.Concat(partes[0][0], partes[partes.Length - 1][0]).ToUpper();
        else if (partes.Length == 1)
            iniciais = partes[0].Substring(0, Math.Min(2, partes[0].Length)).ToUpper();
    }
}

<div class="config-wrapper">
    <div class="config-card">

        <h1>Configurações de Perfil</h1>
        <p class="config-subtitle">Atualize suas informações pessoais e mantenha sua conta sempre em dia.</p>

        @if (ViewBag.Success != null)
        {
            <div class="alert alert-success" role="alert">@ViewBag.Success</div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger" role="alert">@ViewBag.Error</div>
        }

        <form asp-action="Perfil" method="post">
            @Html.AntiForgeryToken()

            <div class="config-section">
                <h2>Foto e identificação</h2>
                <div class="d-flex align-items-center gap-3 mb-3">
                    @if (!string.IsNullOrWhiteSpace(Model.UrlFoto))
                    {
                        <img id="fotoPreview" src="@Model.UrlFoto" alt="Foto de @Model.Nome" class="foto-perfil" />
                    }
                    else
                    {
                        <img id="fotoPreview" alt="Foto de @Model.Nome" class="foto-perfil" style="display:none;" />
                    }
                    <div id="fotoFallback"
                         class="foto-perfil"
                         style="@(string.IsNullOrWhiteSpace(Model.UrlFoto) ? "" : "display:none;")">
                        @iniciais
                    </div>
                    <div class="flex-grow-1">
                        <label for="urlFoto" class="form-label">URL da foto de perfil</label>
                        <input type="url" id="urlFoto" name="urlFoto" class="form-control"
                               value="@Model.UrlFoto" placeholder="https://exemplo.com/minha-foto.jpg" />
                        <small class="text-muted">A pré-visualização aparece automaticamente.</small>
                    </div>
                </div>
            </div>

            <div class="config-section">
                <h2>Informações pessoais</h2>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="nome" class="form-label">Nome completo</label>
                        <input type="text" id="nome" name="nome" class="form-control"
                               value="@Model.Nome" required />
                    </div>
                    <div class="col-md-6">
                        <label for="apelido" class="form-label">Apelido</label>
                        <input type="text" id="apelido" name="apelido" class="form-control"
                               value="@Model.Apelido" placeholder="Como você gosta de ser chamado" />
                    </div>
                    <div class="col-12">
                        <label for="email" class="form-label">E-mail</label>
                        <input type="email" id="email" name="email" class="form-control"
                               value="@Model.Email" required />
                    </div>
                    <div class="col-12">
                        <label for="descricao" class="form-label">Sobre você</label>
                        <textarea id="descricao" name="descricao" class="form-control" rows="3"
                                  placeholder="Conte um pouco sobre suas metas e foco atual">@Model.Descricao</textarea>
                    </div>
                </div>
            </div>

            <div class="config-section">
                <h2>Segurança</h2>
                <p class="description">
                    Para alterar sua senha, enviaremos um link seguro para o seu e-mail cadastrado.
                </p>
                <a asp-action="EsqueciSenha" class="link-senha">
                    Alterar minha senha →
                </a>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-wedo-outline">Cancelar</a>
                <button type="submit" class="btn btn-wedo">Salvar alterações</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        // Pré-visualização da foto: troca entre <img> e fallback de iniciais conforme o usuário cola/limpa a URL
        (function () {
            var input = document.getElementById('urlFoto');
            var preview = document.getElementById('fotoPreview');
            var fallback = document.getElementById('fotoFallback');
            if (!input || !preview || !fallback) return;

            function aplicar() {
                var url = (input.value || '').trim();
                if (url) {
                    preview.src = url;
                    preview.style.display = '';
                    fallback.style.display = 'none';
                } else {
                    preview.removeAttribute('src');
                    preview.style.display = 'none';
                    fallback.style.display = '';
                }
            }
            // Se a URL der erro de carregamento, volta para o fallback
            preview.addEventListener('error', function () {
                preview.style.display = 'none';
                fallback.style.display = '';
            });
            input.addEventListener('input', aplicar);
        })();
    </script>
}
