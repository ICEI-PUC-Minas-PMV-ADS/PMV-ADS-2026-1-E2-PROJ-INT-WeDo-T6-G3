@model WeDo.Models.Meta
@inject IViewLocalizer Localizer

<div class="container mt-4">
    <h2>@Localizer["Editar Meta"]</h2>
    <p class="text-muted">@Localizer["Altere as informações do seu objetivo."]</p>
    <hr />

    <form asp-action="Editar" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="IdUsuarioMeta" />

        <div class="mb-3">
            <label class="form-label">@Localizer["Título da Meta"]</label>
            <input asp-for="Nome" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">@Localizer["Descrição / Detalhes"]</label>
            <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">@Localizer["Categoria"]</label>
            <select asp-for="IdCategoriaMeta" class="form-select" asp-items="ViewBag.IdCategoriaMeta">
                <option value="">@Localizer["-- Selecione uma Categoria --"]</option>
            </select>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">@Localizer["Data Inicial"]</label>
                <input asp-for="DataInicial" class="form-control" type="date" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">@Localizer["Previsão de Término"]</label>
                <input asp-for="DataFinal" class="form-control" type="date" />
            </div>
        </div>

        @{
            bool temRecorrencia = Model.Domingo || Model.Segunda || Model.Terca || Model.Quarta || Model.Quinta || Model.Sexta || Model.Sabado;
        }

        <div class="form-check form-switch mb-3 mt-4">
            <input class="form-check-input" type="checkbox" id="chkAtividadeDiaria" onchange="toggleDiasSemana()" style="cursor: pointer;" @(temRecorrencia ? "checked" : "")>
            <label class="form-check-label fw-bold" for="chkAtividadeDiaria" style="cursor: pointer;">@Localizer["Registrar atividade recorrente?"]</label>
        </div>

        <div id="divDiasSemana" class="card p-3 mb-4 border-primary" style="display: @(temRecorrencia ? "block" : "none"); background-color: var(--wedo-card-bg);">
            <label class="form-label fw-bold mb-3">@Localizer["Quais dias da semana?"]</label>
            <div class="d-flex flex-wrap gap-4">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Domingo" />
                    <label class="form-check-label" asp-for="Domingo">@Localizer["Dom"]</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" asp-for="Segunda" />
                    <label class="form-check-label" asp-for="Segunda">@Localizer["Seg"]</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" asp-for="Terca" />
                    <label class="form-check-label" asp-for="Terca">@Localizer["Ter"]</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" asp-for="Quarta" />
                    <label class="form-check-label" asp-for="Quarta">@Localizer["Qua"]</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" asp-for="Quinta" />
                    <label class="form-check-label" asp-for="Quinta">@Localizer["Qui"]</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" asp-for="Sexta" />
                    <label class="form-check-label" asp-for="Sexta">@Localizer["Sex"]</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" asp-for="Sabado" />
                    <label class="form-check-label" asp-for="Sabado">@Localizer["Sáb"]</label>
                </div>
            </div>
        </div>
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">@Localizer["Salvar Alterações"]</button>

            <button type="button" class="btn btn-danger" onclick="confirmarExclusao()">
                @Localizer["Excluir Meta"]
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancelar"]</a>
        </div>
    </form>

    <form id="formExcluir" asp-action="Excluir" method="post" style="display:none;">
        <input type="hidden" name="id" value="@Model.Id" />
    </form>
</div>

<script>
    function confirmarExclusao() {
        if (confirm('@Localizer["Tem certeza que deseja apagar esta meta permanentemente?"]')) {
            document.getElementById('formExcluir').submit();
        }
    }

    function toggleDiasSemana() {
        var chk = document.getElementById("chkAtividadeDiaria");
        var div = document.getElementById("divDiasSemana");

        if (chk.checked) {
            div.style.display = "block";
        } else {
            div.style.display = "none";
            document.querySelectorAll('#divDiasSemana .form-check-input').forEach(function(el) {
                el.checked = false;
            });
        }
    }
</script>