@model WeDo.Models.AtividadeDiaria

<div class="container mt-4">
    <h2>Registrar Atividade Diária</h2>
    <p class="text-muted">Registre o progresso dos seus objetivos aqui.</p>
    <hr />

    <form asp-action="Registrar">
        <div class="mb-3">
            <label class="form-label">Selecione a Meta Relacionada</label>
            <select asp-for="IdMeta" class="form-select" asp-items="ViewBag.IdMeta">
                <option value="">-- Qual objetivo você avançou? --</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">O que você fez hoje? (Título)</label>
            <input asp-for="Nome" class="form-control" placeholder="Ex: Treino de pernas concluído" />
        </div>

        <div class="mb-3">
            <label class="form-label">Relato / Motivação</label>
            <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Data do Registro</label>
                <input asp-for="Data" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Link da Foto de Comprovação</label>
                <input asp-for="UrlFoto" class="form-control" placeholder="URL da imagem (opcional)" />
            </div>
        </div>

        <button type="submit" class="btn btn-success">Registrar</button>
    </form>
</div>