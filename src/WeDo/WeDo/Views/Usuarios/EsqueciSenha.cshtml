@{
    ViewData["Title"] = "Recuperar Senha";
}

<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 task-details-panel shadow-sm">
            <h2 class="dashboard-title">Esqueci a Senha <i class="bi bi-envelope ms-2 fs-4"></i></h2>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger" style="border-radius: 12px;">
                    @ViewBag.Error
                </div>
            }

            <p class="task-details-desc mb-4">Digite o seu e-mail para receber as instruções para redefinir sua senha.</p>

            <form asp-action="EsqueciSenha" asp-controller="Usuarios" method="post">
                <div class="form-group mb-4">
                    <label for="email" class="font-serif fs-5 mb-2">E-mail de Cadastro</label>
                    <input type="email" class="form-control form-control-lg" id="email" name="email" style="border-radius: 12px; border: 1px solid #d1d5db;" required>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a asp-action="Index" class="text-decoration-none" style="color: var(--wedo-muted); font-style: italic;">Voltar para Login</a>
                    <button type="submit" class="btn rounded-pill px-4 py-2" style="background-color: #6cc88a; color: #000; font-weight: bold; border: 2px solid #000;">Enviar E-mail</button>
                </div>
            </form>
        </div>
    </div>
</div>