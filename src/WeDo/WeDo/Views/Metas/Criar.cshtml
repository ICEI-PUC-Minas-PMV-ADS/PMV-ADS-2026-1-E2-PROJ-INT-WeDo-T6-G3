@model WeDo.Models.Meta

<div class="container mt-4">
    <h2>Nova Meta</h2>
    <p class="text-muted">Defina um novo objetivo para o seu cronograma.</p>
    <hr />

    <form asp-action="Criar" method="post">
        <div class="mb-3">
            <label class="form-label">Título da Meta</label>
            <input asp-for="Nome" class="form-control" placeholder="Ex: Emagrecer 5kg" />
        </div>

        <div class="mb-3">
            <label class="form-label">Descrição / Detalhes</label>
            <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Categoria</label>
            <div class="input-group">
                <select asp-for="IdCategoriaMeta" class="form-select" asp-items="ViewBag.IdCategoriaMeta">
                    <option value="">-- Selecione uma Categoria --</option>
                </select>
        
                @* Botão que força a navegação via JavaScript se o link falhar *@
                <button type="button" class="btn btn-outline-primary" onclick="location.href='/Categorias/Criar'">
                    + Nova
                </button>
            </div>
            <span asp-validation-for="IdCategoriaMeta" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Data Inicial</label>
            <input asp-for="DataInicial" class="form-control" type="date" />
        </div>

        <div class="form-group">
            <label>Previsão de Término</label>
            <input asp-for="DataFinal" class="form-control" type="date" />
        </div>
        <input type="hidden" asp-for="IdUsuarioMeta" value="1" />

        <div class="mt-4">
            <button type="submit" class="btn btn-success">Salvar Meta</button>
            <a asp-controller="Metas" asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
        </div>
    </form>
</div>