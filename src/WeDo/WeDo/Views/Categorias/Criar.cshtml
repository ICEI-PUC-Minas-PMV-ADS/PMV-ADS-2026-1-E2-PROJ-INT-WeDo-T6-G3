@model WeDo.Models.Categoria
@inject IViewLocalizer Localizer

<div class="container mt-4">
    <h2>@Localizer["Cadastrar Nova Categoria"]</h2>
    <p class="text-muted">@Localizer["Crie uma classificação para suas metas (ex: Saúde, Estudos, Trabalho)."]</p>
    <hr />

    <form asp-action="Criar" method="post">
        <div class="mb-3">
            <label class="form-label">@Localizer["Nome da Categoria"]</label>
            <input asp-for="Nome" class="form-control" placeholder="@Localizer["Ex: Finanças"]" required />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">@Localizer["Salvar Categoria"]</button>
            <a asp-controller="Metas" asp-action="Criar" class="btn btn-outline-secondary">@Localizer["Voltar"]</a>
        </div>
    </form>
</div>