@model Usuario

@{
    ViewData["Title"] = "Configurações Gerais";

    // Lista de idiomas disponíveis (renderizada via foreach para evitar conflito do tag helper <option> com C# inline)
    var idiomas = new[]
    {
        new { Valor = Idioma.PortuguesBR, Texto = "Português (Brasil)" },
        new { Valor = Idioma.InglesUS, Texto = "English (US)" },
        new { Valor = Idioma.EspanholES, Texto = "Español" }
    };
}

<div class="config-wrapper">
    <div class="config-card">

        <h1>Configurações Gerais</h1>
        <p class="config-subtitle">Personalize sua experiência no WeDo. Suas preferências são salvas na sua conta.</p>

        @if (ViewBag.Success != null)
        {
            <div class="alert alert-success" role="alert">@ViewBag.Success</div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger" role="alert">@ViewBag.Error</div>
        }

        <form asp-action="Configuracoes" method="post">
            @Html.AntiForgeryToken()

            <div class="config-section">
                <h2>Idioma</h2>
                <p class="description">Selecione o idioma de exibição do sistema.</p>
                <select id="idioma" name="idioma" class="form-select" style="max-width: 320px;">
                    @foreach (var op in idiomas)
                    {
                        if (Model.Idioma == op.Valor)
                        {
                            <option value="@op.Valor" selected>@op.Texto</option>
                        }
                        else
                        {
                            <option value="@op.Valor">@op.Texto</option>
                        }
                    }
                </select>
            </div>

            <div class="config-section">
                <h2>Tema</h2>
                <p class="description">Escolha entre o tema claro ou escuro para a interface.</p>
                <div class="d-flex gap-4 flex-wrap">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="tema"
                               id="temaClaro" value="@Tema.Claro"
                               @(Model.Tema == Tema.Claro ? "checked" : "") />
                        <label class="form-check-label" for="temaClaro">Tema claro</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="tema"
                               id="temaEscuro" value="@Tema.Escuro"
                               @(Model.Tema == Tema.Escuro ? "checked" : "") />
                        <label class="form-check-label" for="temaEscuro">Tema escuro</label>
                    </div>
                </div>
            </div>

            <div class="config-section">
                <h2>Notificações</h2>
                <p class="description">Defina como você quer ser avisado sobre suas metas e conquistas.</p>

                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="notificacoesEmail" name="notificacoesEmail" value="true"
                           @(Model.NotificacoesEmail ? "checked" : "") />
                    <label class="form-check-label" for="notificacoesEmail">
                        Receber notificações por <strong>e-mail</strong>
                    </label>
                </div>

                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="notificacoesPush" name="notificacoesPush" value="true"
                           @(Model.NotificacoesPush ? "checked" : "") />
                    <label class="form-check-label" for="notificacoesPush">
                        Receber notificações <strong>push</strong> no navegador
                    </label>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-wedo-outline">Cancelar</a>
                <button type="submit" class="btn btn-wedo">Salvar configurações</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Aplica o tema imediatamente como preview, antes mesmo de salvar.
        // O valor real só é persistido no submit do formulário.
        document.querySelectorAll('input[name="tema"]').forEach(function (radio) {
            radio.addEventListener('change', function () {
                document.body.classList.toggle('tema-escuro', this.value === 'Escuro');
            });
        });
    </script>
}
