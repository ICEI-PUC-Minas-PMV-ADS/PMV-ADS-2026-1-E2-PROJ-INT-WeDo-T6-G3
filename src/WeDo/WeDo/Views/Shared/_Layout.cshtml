@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using WeDo.Models
@inject AppDbContext DbContext
@inject IViewLocalizer Localizer

@{
    // Aplica o tema preferido do usuário logado (RF-013).
    // Falha silenciosamente para não derrubar o layout se o banco estiver indisponível.
    string bodyClass = "";

    if (User?.Identity?.IsAuthenticated == true)
    {
        try
        {
            var idClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (int.TryParse(idClaim, out var idUsuario))
            {
                var temaUsuario = await DbContext.Usuarios
                    .Where(u => u.Id == idUsuario)
                    .Select(u => (Tema?)u.Tema)
                    .FirstOrDefaultAsync();

                if (temaUsuario == Tema.Escuro)
                    bodyClass = "tema-escuro";
            }
        }
        catch
        {
            // Mantém tema claro como fallback
        }
    }
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WeDo</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WeDo.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body class="@bodyClass">

    <div class="wrapper">

        <nav id="sidebar" class="sidebar shadow-sm">
            <div class="d-flex align-items-center mb-5 px-3" style="height: 40px;">
                <i class="bi bi-leaf-fill text-success fs-1 me-2"></i>
                <span class="fs-3 fw-bold logo-text font-serif">WeDo</span>
            </div>

            <ul class="nav flex-column mb-auto">
                <li class="nav-item">
                    <a asp-controller="Home" asp-action="Index" class="nav-link active">
                        <i class="bi bi-house-door fs-5 me-3"></i>
                        <span class="sidebar-text">@Localizer["DashBoard"]</span>
                    </a>
                </li>
                <li class="nav-item mt-2">
                    <a asp-controller="Metas" asp-action="Index" class="nav-link">
                        <i class="bi bi-list-check fs-5 me-3"></i>
                        <span class="sidebar-text">@Localizer["Metas"]</span>
                    </a>
                </li>
                <li class="nav-item mt-2">
                    <a asp-controller="AtividadesDiarias" asp-action="Registrar" class="nav-link">
                        <i class="bi bi-pencil-square fs-5 me-3"></i>
                        <span class="sidebar-text">@Localizer["Registrar Atividade"]</span>
                    </a>
                </li>
                <li class="nav-item mt-2">
                    <a href="#" class="nav-link">
                        <i class="bi bi-graph-up fs-5 me-3"></i>
                        <span class="sidebar-text">@Localizer["Mural"]</span>
                    </a>
                </li>
                <li class="nav-item mt-2">
                    <a href="#" class="nav-link">
                        <i class="bi bi-clock-history fs-5 me-3"></i>
                        <span class="sidebar-text">@Localizer["Histórico"]</span>
                    </a>
                </li>
            </ul>
        </nav>

        <div class="main-container shadow-sm">

            @{
                // Identifica a página atual para destacar o ícone correspondente na topbar (estado ativo).
                var acaoAtual = ViewContext.RouteData.Values["action"]?.ToString();
                var controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString();
                var emConfiguracoes = controllerAtual == "Usuarios" && acaoAtual == "Configuracoes";
                var emPerfil = controllerAtual == "Usuarios" && acaoAtual == "Perfil";
            }
            <header class="topbar">
                <button id="toggleSidebar" class="btn btn-light border-0" style="background: transparent;">
                    <i class="bi bi-list fs-2" style="color: var(--wedo-text);"></i>
                </button>

                <div class="topbar-icons">
                    <i class="bi bi-bell"></i>
                    <a asp-controller="Usuarios" asp-action="Configuracoes"
                       class="topbar-link @(emConfiguracoes ? "active" : "")"
                       title="@Localizer["Configurações Gerais"]" aria-label="@Localizer["Configurações Gerais"]">
                        <i class="bi bi-gear"></i>
                    </a>
                    <a asp-controller="Usuarios" asp-action="Perfil"
                       class="topbar-link @(emPerfil ? "active" : "")"
                       title="@Localizer["Configurações de Perfil"]" aria-label="@Localizer["Configurações de Perfil"]">
                        <i class="bi bi-person-circle"></i>
                    </a>
                </div>
            </header>

            <main class="content-area">
                @RenderBody()
            </main>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.getElementById('toggleSidebar').addEventListener('click', function() {
        var sidebar = document.getElementById('sidebar');
        sidebar.classList.toggle('collapsed');
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>