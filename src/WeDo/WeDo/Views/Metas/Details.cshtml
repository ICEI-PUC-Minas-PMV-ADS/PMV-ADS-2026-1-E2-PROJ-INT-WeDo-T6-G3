@model WeDo.Models.Meta
@inject IViewLocalizer Localizer

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h2>@Localizer["Detalhes da Meta:"] @Model.Nome</h2>
        <div>
            <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-warning">@Localizer["Editar Meta"]</a>
            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Voltar"]</a>
        </div>
    </div>
    <hr />

    <div class="row mb-4">
        <div class="col-md-4">
            <p><strong>@Localizer["Categoria:"]</strong> @(Model.Categoria?.Nome ?? Localizer["Sem Categoria"].Value)</p>
            <p><strong>@Localizer["Condição:"]</strong> @Model.Condicao</p>
        </div>
        <div class="col-md-4">
            <p><strong>@Localizer["Início:"]</strong> @Model.DataInicial.ToShortDateString()</p>
            <p><strong>@Localizer["Término:"]</strong> @Model.DataFinal.ToShortDateString()</p>
        </div>
        <div class="col-md-4">
            <p><strong>@Localizer["Descrição:"]</strong> @Model.Descricao</p>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-5">
        <h3>📌 @Localizer["Histórico de Atividades Diárias"]</h3>
        <a asp-controller="AtividadesDiarias" asp-action="Registrar" class="btn btn-success btn-sm">
            @Localizer["+ Registrar Novo Progresso"]
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover mt-3">
            <thead class="table-dark">
                <tr>
                    <th>@Localizer["Data"]</th>
                    <th>@Localizer["Título da Atividade"]</th>
                    <th>@Localizer["Descrição/Relato"]</th>
                    <th>@Localizer["Evidência (Foto)"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.AtividadesDiarias != null && Model.AtividadesDiarias.Any())
                {
                    @foreach (var atividade in Model.AtividadesDiarias.OrderByDescending(a => a.Data))
                    {
                        <tr>
                            <td>@atividade.Data.ToShortDateString()</td>
                            <td><strong>@atividade.Nome</strong></td>
                            <td>@atividade.Descricao</td>
                            <td>
                                @if (!string.IsNullOrEmpty(atividade.UrlFoto))
                                {
                                    <a href="@atividade.UrlFoto" target="_blank" class="btn btn-sm btn-outline-info">@Localizer["Ver Foto"]</a>
                                }
                                else
                                {
                                    <span class="text-muted">@Localizer["Sem foto"]</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">
                            @Localizer["Nenhuma atividade registrada para esta meta até o momento."]
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>