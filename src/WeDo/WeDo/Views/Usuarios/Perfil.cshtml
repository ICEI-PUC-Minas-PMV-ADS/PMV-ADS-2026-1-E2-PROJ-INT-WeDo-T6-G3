@model WeDo.Models.Usuario

@{
    ViewData["Title"] = "Configurações de Perfil";
    string iniciais = "?";
    if (!string.IsNullOrWhiteSpace(Model?.Nome))
    {
        var partes = Model.Nome.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length >= 2)
            iniciais = string.Concat(partes[0][0], partes[partes.Length - 1][0]).ToUpper();
        else if (partes.Length == 1)
            iniciais = partes[0].Substring(0, Math.Min(2, partes[0].Length)).ToUpper();
    }
}

<div class="config-wrapper">
    <div class="config-card">

        <h1>Configurações de Perfil</h1>
        <p class="config-subtitle">Atualize suas informações pessoais e mantenha sua conta sempre em dia.</p>

        @if (ViewBag.Success != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @ViewBag.Success
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
            </div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
            </div>
        }

        <form asp-action="Perfil" method="post">
            @Html.AntiForgeryToken()

            <div class="config-section">
                <h2><i class="bi bi-image me-2"></i>Foto e identificação</h2>
                <div class="d-flex align-items-center gap-3 mb-3">
                    @if (!string.IsNullOrWhiteSpace(Model.UrlFoto))
                    {
                        <img id="fotoPreview" src="@Model.UrlFoto" alt="Foto de @Model.Nome" class="foto-perfil" />
                    }
                    else
                    {
                        <img id="fotoPreview" alt="Foto de @Model.Nome" class="foto-perfil" style="display:none;" />
                    }
                    <div id="fotoFallback"
                         class="foto-perfil"
                         style="@(string.IsNullOrWhiteSpace(Model.UrlFoto) ? "" : "display:none;")">
                        @iniciais
                    </div>
                    <div class="flex-grow-1">
                        <label asp-for="UrlFoto" class="form-label">URL da foto de perfil</label>
                        <input asp-for="UrlFoto" type="url" id="urlFoto" class="form-control"
                               placeholder="https://exemplo.com/minha-foto.jpg" />
                        <span asp-validation-for="UrlFoto" class="text-danger"></span>
                        <small class="text-muted d-block">A pré-visualização aparece automaticamente.</small>
                    </div>
                </div>
            </div>

            <div class="config-section">
                <h2><i class="bi bi-person-vcard me-2"></i>Informações pessoais</h2>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Nome" class="form-label">Nome completo</label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Apelido" class="form-label">Apelido</label>
                        <input asp-for="Apelido" class="form-control"
                               placeholder="Como você gosta de ser chamado" />
                        <span asp-validation-for="Apelido" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Email" class="form-label">E-mail</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Descricao" class="form-label">Sobre você</label>
                        <textarea asp-for="Descricao" class="form-control" rows="3"
                                  placeholder="Conte um pouco sobre suas metas e foco atual"></textarea>
                        <span asp-validation-for="Descricao" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="config-section">
                <h2><i class="bi bi-shield-lock me-2"></i>Segurança</h2>
                <p class="description">
                    Para alterar sua senha, enviaremos um link seguro para o seu e-mail cadastrado.
                </p>
                <a asp-action="EsqueciSenha" class="link-senha">
                    Alterar minha senha →
                </a>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-wedo-outline">Cancelar</a>
                <button type="submit" class="btn btn-wedo">
                    <i class="bi bi-check-circle me-1"></i>Salvar alterações
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        // Pré-visualização da foto: troca entre <img> e fallback de iniciais conforme o usuário cola/limpa a URL
        (function () {
            var input = document.getElementById('urlFoto');
            var preview = document.getElementById('fotoPreview');
            var fallback = document.getElementById('fotoFallback');
            if (!input || !preview || !fallback) return;

            function aplicar() {
                var url = (input.value || '').trim();
                if (url) {
                    preview.src = url;
                    preview.style.display = '';
                    fallback.style.display = 'none';
                } else {
                    preview.removeAttribute('src');
                    preview.style.display = 'none';
                    fallback.style.display = '';
                }
            }
            // Se a URL der erro de carregamento, volta para o fallback
            preview.addEventListener('error', function () {
                preview.style.display = 'none';
                fallback.style.display = '';
            });
            input.addEventListener('input', aplicar);
        })();
    </script>
}
